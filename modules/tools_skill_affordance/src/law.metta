(= (tools-skill-affordance--member? $ref $refs)
 (if (== $refs ()) False (or (== $ref (car-atom $refs)) (tools-skill-affordance--member? $ref (cdr-atom $refs)))))
(= (tools-skill-affordance--missing $requirements $available)
 (if (== $requirements ()) ()
  (if (tools-skill-affordance--member? (car-atom $requirements) $available)
   (tools-skill-affordance--missing (cdr-atom $requirements) $available)
   (cons-atom (car-atom $requirements) (tools-skill-affordance--missing (cdr-atom $requirements) $available)))))
(= (tools-skill-affordance--nominate $descriptor $available)
 (case $descriptor
  (((SkillDescriptorSampleV1 $id $version $skill $effect $requirements authority-none)
    (if (not (and (is-expr $requirements) (is-expr $available))) (ToolsRefusalV1 invalid-prerequisites)
     (let $missing (tools-skill-affordance--missing $requirements $available)
      (SkillNominationSampleV1 $id $version $skill $effect $missing separate-execution-admission-required))))
   ($invalid (ToolsRefusalV1 invalid-skill-descriptor)))))
