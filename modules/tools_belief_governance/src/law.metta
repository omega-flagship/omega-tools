;; Source-bound dependency projection. Function symbols namespaced; data constructors unchanged.
(= (tools-belief-governance--immune-abs $x) (abs-math $x))
(= (tools-belief-governance--immune-admit $belief (stv $f $c) $context) (if (tools-belief-governance--immune-geq (tools-belief-governance--immune-abs (- $f 0.5)) (tools-belief-governance--immune-tcon $context)) (if (tools-belief-governance--immune-geq $c (tools-belief-governance--immune-support-admit)) (admitted $belief (stv $f $c) $context) (if (tools-belief-governance--immune-geq $c (tools-belief-governance--immune-support-floor)) (quarantined Q_UNDERSUPPORTED $belief (stv $f $c) $context) (rejected LOW_SUPPORT $belief (stv $f $c) $context))) (quarantined Q_AMBIGUOUS $belief (stv $f $c) $context)))
(= (tools-belief-governance--immune-c2w $c) (/ $c (- 1 $c)))
(= (tools-belief-governance--immune-c2w-capped $c) (tools-belief-governance--immune-c2w (tools-belief-governance--immune-min 0.9999 $c)))
(= (tools-belief-governance--immune-epsilon) 0.000000001)
(= (tools-belief-governance--immune-exact-intersection-size $items $other) (tools-belief-governance--immune-exact-intersection-size-with-seen $items $other ()))
(= (tools-belief-governance--immune-exact-intersection-size-with-seen $items $other $seen) (if (== $items ()) 0 (let* (($item (car-atom $items)) ($rest (cdr-atom $items))) (if (tools-belief-governance--immune-exact-member? $item $seen) (tools-belief-governance--immune-exact-intersection-size-with-seen $rest $other $seen) (let $next-seen (union-atom $seen ($item)) (if (tools-belief-governance--immune-exact-member? $item $other) (+ 1 (tools-belief-governance--immune-exact-intersection-size-with-seen $rest $other $next-seen)) (tools-belief-governance--immune-exact-intersection-size-with-seen $rest $other $next-seen)))))))
(= (tools-belief-governance--immune-exact-member? $needle $items) (if (== $items ()) False (if (== $needle (car-atom $items)) True (tools-belief-governance--immune-exact-member? $needle (cdr-atom $items)))))
(= (tools-belief-governance--immune-exact-unique-size $items) (tools-belief-governance--immune-exact-unique-size-with-seen $items ()))
(= (tools-belief-governance--immune-exact-unique-size-with-seen $items $seen) (if (== $items ()) 0 (let* (($item (car-atom $items)) ($rest (cdr-atom $items))) (if (tools-belief-governance--immune-exact-member? $item $seen) (tools-belief-governance--immune-exact-unique-size-with-seen $rest $seen) (+ 1 (tools-belief-governance--immune-exact-unique-size-with-seen $rest (union-atom $seen ($item))))))))
(= (tools-belief-governance--immune-geq $a $b) (>= (+ $a (tools-belief-governance--immune-epsilon)) $b))
(= (tools-belief-governance--immune-jaccard $S1raw $S2raw) (if (or (== $S1raw ()) (== $S2raw ())) 0 (let* (($inter (tools-belief-governance--immune-exact-intersection-size $S1raw $S2raw)) ($n1 (tools-belief-governance--immune-exact-unique-size $S1raw)) ($n2 (tools-belief-governance--immune-exact-unique-size $S2raw)) ($uni (- (+ $n1 $n2) $inter))) (if (== $uni 0) 0 (/ $inter $uni)))))
(= (tools-belief-governance--immune-max $a $b) (if (>= $a $b) $a $b))
(= (tools-belief-governance--immune-min $a $b) (if (<= $a $b) $a $b))
(= (tools-belief-governance--immune-profile internal) 0.20)
(= (tools-belief-governance--immune-profile action) 0.25)
(= (tools-belief-governance--immune-profile high-stakes) 0.30)
(= (tools-belief-governance--immune-support-admit) 0.60)
(= (tools-belief-governance--immune-support-floor) 0.40)
(= (tools-belief-governance--immune-tcon $context) (tools-belief-governance--immune-profile $context))
(= (tools-belief-governance--immune-w2c $w) (/ $w (+ $w 1)))
(= (tools-belief-governance--prov-revise ($f1 $c1 $S1) ($f2 $c2 $S2)) (let* (($J (tools-belief-governance--immune-jaccard $S1 $S2)) ($w1 (tools-belief-governance--immune-c2w-capped $c1)) ($w2 (tools-belief-governance--immune-c2w-capped $c2)) ($w2p (* $w2 (- 1 $J))) ($w (+ $w1 $w2p)) ($f (/ (+ (* $w1 $f1) (* $w2p $f2)) $w)) ($c (tools-belief-governance--immune-w2c $w)) ($c2eff (tools-belief-governance--immune-w2c $w2p))) (stv (tools-belief-governance--immune-min 1.0 $f) (tools-belief-governance--immune-min 0.99 (tools-belief-governance--immune-max (tools-belief-governance--immune-max $c $c1) $c2eff)))))
