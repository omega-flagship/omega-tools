(= (tools-belief-appraise $belief $truth-value $context) (ToolsSampleResultV1 belief-governance (tools-belief-governance--immune-admit $belief $truth-value $context) inspect-simulate authority-none))
(= (tools-provenance-revise $left $right) (ToolsSampleResultV1 belief-governance (tools-belief-governance--prov-revise $left $right) inspect-simulate authority-none))
