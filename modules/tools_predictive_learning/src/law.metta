(= (tools-predictive-learning--score $prediction $target)
 (case ($prediction $target)
  ((((PredictionSampleV1 $id $model $context $sealed $probability)
     (TargetSampleV1 $target-id $target-context $observed $value))
    (if (not (and (== (get-type $sealed) Number) (and (== (get-type $observed) Number)
              (and (== (get-type $probability) Number) (== (get-type $value) Number)))))
      (ToolsRefusalV1 invalid-numeric-input)
      (if (not (and (>= $sealed 0) (> $observed $sealed)))
        (ToolsRefusalV1 prequential-fence-violated)
        (if (not (== $context $target-context)) (ToolsRefusalV1 wrong-context)
          (if (not (and (and (>= $probability 0) (<= $probability 1)) (or (== $value 0) (== $value 1))))
            (ToolsRefusalV1 invalid-binary-distribution)
            (PredictionScoreSampleV1 $id $target-id $model $context brier
              (* (- $probability $value) (- $probability $value)) prediction-not-evidence))))))
   ($invalid (ToolsRefusalV1 invalid-prediction-shape)))))
