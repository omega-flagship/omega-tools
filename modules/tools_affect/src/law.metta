(= (tools-affect--appraise $state)
 (case $state
  (((RestPressureSampleV1 $id $debt $energy $reserve $availability $unfinished)
    (if (not (and (== (get-type $debt) Number) (and (== (get-type $energy) Number) (== (get-type $reserve) Number))))
      (ToolsRefusalV1 invalid-pressure)
      (if (not (and (>= $debt 0) (and (>= $energy 0) (>= $reserve 0)))) (ToolsRefusalV1 invalid-pressure)
       (if (or (>= $debt 10) (<= $energy $reserve))
         (RestSuggestionSampleV1 $id rest continuity-preserved no-succession)
         (if (== $availability unavailable)
           (RestSuggestionSampleV1 $id quiet-exploration no-message)
           (if (== $availability available)
             (RestSuggestionSampleV1 $id foreground-work $unfinished)
             (ToolsRefusalV1 unknown-availability)))))))
   ($invalid (ToolsRefusalV1 invalid-rest-shape)))))
