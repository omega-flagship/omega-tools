(= (tools-substrates--member? $ref $refs)
 (if (== $refs ()) False (or (== $ref (car-atom $refs)) (tools-substrates--member? $ref (cdr-atom $refs)))))
(= (tools-substrates--missing $required $features)
 (if (== $required ()) ()
  (if (tools-substrates--member? (car-atom $required) $features)
   (tools-substrates--missing (cdr-atom $required) $features)
   (cons-atom (car-atom $required) (tools-substrates--missing (cdr-atom $required) $features)))))
(= (tools-substrates--check $capabilities $request)
 (case ($capabilities $request)
  ((((SubstrateCapabilitiesSampleV1 $runtime $revision $features authority-none)
     (SubstrateRequestSampleV1 $id $required))
    (if (not (and (is-expr $features) (is-expr $required))) (ToolsRefusalV1 invalid-feature-lists)
     (let $missing (tools-substrates--missing $required $features)
      (SubstrateFitSampleV1 $id $runtime $revision $missing supplied-capability-observation no-parity-claim))))
   ($invalid (ToolsRefusalV1 invalid-substrate-shape)))))
