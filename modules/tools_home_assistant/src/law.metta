(= (tools-home-assistant--propose $observation $intent)
 (case ($observation $intent)
  ((((HomeDeviceSampleV1 $entity light $revision $state)
     (HomeLightIntentSampleV1 $id $target $expected-revision $action))
    (if (not (== $entity $target)) (ToolsRefusalV1 wrong-home-target)
     (if (not (== $revision $expected-revision)) (ToolsRefusalV1 stale-home-observation)
      (if (or (== $action turn-on) (== $action turn-off))
       (HomeServiceProposalSampleV1 $id homeassistant (if (== $action turn-on) turn_on turn_off) $entity $revision fresh-effect-permit-and-readback-required)
       (ToolsRefusalV1 unsupported-home-action)))))
   ($invalid (ToolsRefusalV1 unsupported-home-domain-or-shape)))))
