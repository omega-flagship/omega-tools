(= (tools-scratch-plans--promote $head $proposal)
 (case ($head $proposal)
  ((((ScratchHeadSampleV1 $scope $version $cycle)
     (ScratchPromotionSampleV1 $id $proposal-scope $proposal-version $expires $classification $payload $provenance))
    (if (not (and (== $scope $proposal-scope) (== $version $proposal-version)))
      (ToolsRefusalV1 stale-or-cross-scope)
      (if (not (and (== (get-type $cycle) Number) (== (get-type $expires) Number)))
        (ToolsRefusalV1 invalid-clock)
        (if (or (< $cycle 0) (<= $expires $cycle)) (ToolsRefusalV1 expired-scratch)
          (if (not (== $classification shareable-candidate))
            (ToolsRefusalV1 private-or-simulation-remains-scratch)
            (ScratchPromotionProposalV1 $id $scope $version $payload $provenance owner-review-required))))))
   ($invalid (ToolsRefusalV1 invalid-scratch-shape)))))
